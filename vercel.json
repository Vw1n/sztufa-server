{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/sharp/**/*",
          "node_modules/@img/**/*",
          "node_modules/@napi-rs/**/*",
          "node_modules/pdfjs-dist/legacy/build/**/*",
          "node_modules/pdfjs-dist/wasm/**/*",
          "node_modules/pdfjs-dist/standard_fonts/**/*",
          "node_modules/pdfjs-dist/cmaps/**/*"
        ],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/backups/auto-backup",
      "schedule": "0 3 * * 1"
    }
  ]
}
