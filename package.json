{
  "name": "sztu-fa-backend",
  "version": "1.0.0",
  "description": "校园足球信息管理平台后端服务",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "build": "npx nest build",
    "vercel-build": "node scripts/run-vercel-build.js",
    "test": "jest",
    "test:integration:backup": "jest --runInBand --config jest.integration.config.js",
    "test:backup-memory": "jest --runInBand --testPathIgnorePatterns=\"^$\" src/backup/backup-memory.spec.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:check": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:init": "prisma init",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node src/seeds/seed.ts",
    "baseline:preserve-v1": "node -e \"const fs = require('fs'); if (!fs.existsSync('scripts/baseline-v1-pre-draft.json')) { fs.copyFileSync('scripts/pre-migration-baseline.json', 'scripts/baseline-v1-pre-draft.json', fs.constants.COPYFILE_EXCL); console.log('[BASELINE V1 LOCKED] baseline-v1-pre-draft.json 首次只读锁存完成'); } else { console.log('[BASELINE V1 LOCKED] baseline-v1-pre-draft.json 已锁定存在，禁止覆盖'); }\"",
    "baseline:capture-v2": "ts-node scripts/capture-data-baseline.ts --output baseline-v2-before-v8.json",
    "baseline:compare-v1": "ts-node scripts/compare-data-baseline.ts --input baseline-v1-pre-draft.json",
    "baseline:compare-v2": "ts-node scripts/compare-data-baseline.ts --input baseline-v2-before-v8.json",
    "baseline:capture": "ts-node scripts/capture-data-baseline.ts",
    "baseline:compare": "ts-node scripts/compare-data-baseline.ts"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@napi-rs/canvas": "0.1.80",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.7.0",
    "@types/passport-jwt": "^4.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfjs-dist": "4.10.38",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.2",
    "stream-json": "^1.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/stream-json": "^1.7.8",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "prisma": "^5.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/scripts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "\\.integration\\.spec\\.ts$",
      "backup-memory\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
