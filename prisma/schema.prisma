generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Team {
  id              String              @id @default(cuid())
  teamName        String
  teamDoctor      String?
  headCoach       String?
  teamLeader      String?
  coachPhone      String?
  leaderPhone     String?
  homeJerseyColor String
  awayJerseyColor String
  teamLogo        String?
  homeJersey      String?
  awayJersey      String?
  gender          String              @default("MALE") // MALE: 男子, FEMALE: 女子
  players         Player[]
  homeMatches     Match[]             @relation("HomeTeam")
  awayMatches     Match[]             @relation("AwayTeam")
  users           User[]
  deletedAt       DateTime?
  seasonPlayers   SeasonTeamPlayer[]
  seasonProfiles  SeasonTeamProfile[]
  groupTeams      SeasonGroupTeam[]
  registrations   TeamRegistration[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([teamName])
  @@index([deletedAt])
}

model Player {
  id                  String               @id @default(cuid())
  name                String
  studentId           String
  legacyKey           String?              @unique
  jerseyNumber        String
  photo               String?
  status              String               @default("active")
  yellowCards         Int                  @default(0)
  redCards            Int                  @default(0)
  suspendedAtMatchId  String?
  suspendedAtMatch    Match?               @relation("PlayerSuspensionMatch", fields: [suspendedAtMatchId], references: [id], onDelete: SetNull)
  teamId              String
  team                Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  goals               Goal[]
  events              MatchEvent[]         @relation("EventPlayer")
  subEvents           MatchEvent[]         @relation("EventSubPlayer")
  assistEvents        MatchEvent[]         @relation("EventAssistPlayer")
  mvpMatches          Match[]              @relation("MatchMvpPlayer")
  deletedAt           DateTime?
  seasonPlayers       SeasonTeamPlayer[]
  matchLineups        MatchLineup[]
  registrationPlayers RegistrationPlayer[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([teamId])
  @@index([studentId])
  @@index([deletedAt])
  @@index([teamId, deletedAt])
}

model Match {
  id                 String        @id @default(cuid())
  legacyGameId       String?       @unique
  homeTeamId         String
  awayTeamId         String
  homeTeam           Team          @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam           Team          @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  homeScore          Int           @default(0)
  awayScore          Int           @default(0)
  homePenaltyScore   Int?
  awayPenaltyScore   Int?
  winnerTeamId       String?
  decidedBy          String?
  matchDate          DateTime
  location           String
  status             String        @default("scheduled")
  goals              Goal[]
  events             MatchEvent[]
  seasonId           String?
  season             Season?       @relation(fields: [seasonId], references: [id])
  mvpPlayerId        String?
  mvpPlayer          Player?       @relation("MatchMvpPlayer", fields: [mvpPlayerId], references: [id])
  suspendedPlayers   Player[]      @relation("PlayerSuspensionMatch")
  mvpPlayerName      String?
  lineups            MatchLineup[]
  stage              String        @default("LEAGUE") // LEAGUE, GROUP, KNOCKOUT
  groupName          String?
  knockoutRound      String?
  knockoutMatchIndex Int?
  deletedAt          DateTime?
  predictions        Prediction[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([matchDate])
  @@index([seasonId, deletedAt])
  @@index([seasonId, stage, deletedAt])
  @@index([mvpPlayerId])
  @@index([deletedAt])
}

enum PredictionChoice {
  HOME_WIN
  DRAW
  AWAY_WIN
}

enum PredictionStatus {
  PENDING
  CORRECT
  WRONG
  VOID
}

model Prediction {
  id            String           @id @default(cuid())
  userId        String
  matchId       String
  choice        PredictionChoice
  status        PredictionStatus @default(PENDING)
  awardedPoints Int              @default(0)
  submittedAt   DateTime         @default(now())
  settledAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user  MemberAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId, choice])
  @@index([userId, status])
  @@index([settledAt])
}

model Goal {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId     String?
  player       Player?  @relation(fields: [playerId], references: [id])
  playerName   String
  jerseyNumber String
  goalTime     String
  teamType     String
  createdAt    DateTime @default(now())

  @@index([matchId])
  @@index([playerId])
}

model MatchEvent {
  id                 String   @id @default(cuid())
  matchId            String
  match              Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  eventTime          String
  eventType          String
  phase              String   @default("REGULAR")
  shootoutRound      Int?
  shootoutOrder      Int?
  playerId           String?
  player             Player?  @relation("EventPlayer", fields: [playerId], references: [id])
  playerName         String?
  jerseyNumber       String?
  subPlayerId        String?
  subPlayer          Player?  @relation("EventSubPlayer", fields: [subPlayerId], references: [id])
  subPlayerName      String?
  subJerseyNumber    String?
  assistPlayerId     String?
  assistPlayer       Player?  @relation("EventAssistPlayer", fields: [assistPlayerId], references: [id])
  assistPlayerName   String?
  assistJerseyNumber String?
  description        String
  teamType           String
  createdAt          DateTime @default(now())

  @@index([matchId])
  @@index([playerId])
  @@index([subPlayerId])
  @@index([assistPlayerId])
  @@index([matchId, eventTime])
  @@index([matchId, phase, shootoutOrder])
}

model News {
  id          String    @id @default(cuid())
  title       String
  category    String
  content     String    @default("")
  description String    @default("")
  coverImage  String?
  wechatUrl   String?
  isPinned    Boolean   @default(false)
  viewCount   Int       @default(0)
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  date        String    @default("") // 格式如 "2026-06-10"
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([published])
  @@index([publishedAt])
  @@index([deletedAt])
}

model User {
  id                      String                   @id @default(cuid())
  username                String                   @unique
  studentId               String?                  @unique
  nickname                String?
  password                String
  role                    String                   @default("match_scorer")
  sessionVersion          Int                      @default(0)
  teamId                  String?
  team                    Team?                    @relation(fields: [teamId], references: [id])
  seasonDeletionApprovals SeasonDeletionApproval[]
  submittedRegistrations  TeamRegistration[]       @relation("RegistrationSubmittedBy")
  reviewedRegistrations   TeamRegistration[]       @relation("RegistrationReviewedBy")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([username])
  @@index([studentId])
  @@index([teamId])
}

model AuditLog {
  id        String   @id @default(cuid())
  username  String
  action    String
  details   String
  createdAt DateTime @default(now())

  @@index([username])
  @@index([createdAt])
}

model Season {
  id                String                   @id @default(cuid())
  name              String                   @unique
  status            String                   @default("active") // active, archived
  type              String                   @default("LEAGUE") // LEAGUE, CUP
  matches           Match[]
  standingsCache    Json?
  statsCache        Json?
  teamPlayers       SeasonTeamPlayer[]
  teamProfiles      SeasonTeamProfile[]
  groupTeams        SeasonGroupTeam[]
  deletionApprovals SeasonDeletionApproval[]
  registrations     TeamRegistration[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

model SeasonTeamProfile {
  id              String   @id @default(cuid())
  seasonId        String
  teamId          String
  teamName        String
  teamDoctor      String?
  headCoach       String?
  teamLeader      String?
  coachPhone      String?
  leaderPhone     String?
  homeJerseyColor String
  awayJerseyColor String
  teamLogo        String?
  homeJersey      String?
  awayJersey      String?
  gender          String
  isRegistered    Boolean  @default(false)
  season          Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([seasonId, teamId])
  @@index([seasonId])
  @@index([seasonId, isRegistered])
  @@index([teamId])
}

model HistoryImportBatch {
  id          String    @id @default(cuid())
  digest      String
  username    String
  status      String    @default("completed")
  summary     Json
  undoPayload Json
  createdAt   DateTime  @default(now())
  undoneAt    DateTime?

  @@index([status, createdAt])
}

model SeasonDeletionApproval {
  id         String   @id @default(cuid())
  seasonId   String
  approverId String
  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  approver   User     @relation(fields: [approverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([seasonId, approverId])
  @@index([seasonId])
  @@index([approverId])
}

model SeasonTeamPlayer {
  id           String   @id @default(cuid())
  seasonId     String
  teamId       String
  playerId     String
  playerName   String
  studentId    String
  jerseyNumber String
  playerPhoto  String?
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([seasonId, playerId])
  @@index([seasonId])
  @@index([seasonId, studentId])
  @@index([teamId])
  @@index([playerId])
}

model MatchLineup {
  id         String @id @default(cuid())
  matchId    String
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamType   String // "home" | "away"
  lineupType String // "starting" | "substitute"

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([playerId])
}

model SeasonGroupTeam {
  id        String   @id @default(cuid())
  seasonId  String
  teamId    String
  groupName String // e.g. "A", "B", "C", "D"
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([seasonId, teamId])
  @@index([seasonId])
  @@index([teamId])
}

enum PdfImportBatchStatus {
  PREVIEW
  COMMITTING
  COMMITTED
  FAILED
  CANCELLED
  EXPIRED
}

model PdfImportBatch {
  id              String               @id @default(cuid())
  fileHash        String
  username        String
  status          PdfImportBatchStatus @default(PREVIEW)
  previewData     Json?
  expiresAt       DateTime
  commitStartedAt DateTime?
  committedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  finalObjectKeys Json?
  cleanupRequired Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([username, status])
  @@index([expiresAt])
  @@index([fileHash])
}

model AdminFormDraft {
  id               String   @id @default(cuid())
  formType         String
  payload          Json
  seasonId         String?
  officialRecordId String?
  status           String   @default("DRAFT")
  lastError        String?
  username         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([formType, status, updatedAt])
  @@index([username, updatedAt])
  @@index([officialRecordId])
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

model TeamRegistration {
  id            String             @id @default(cuid())
  seasonId      String
  teamId        String
  submittedById String
  status        RegistrationStatus @default(DRAFT)
  reviewComment String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  season      Season                @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submittedBy User                  @relation("RegistrationSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy  User?                 @relation("RegistrationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  teamData    RegistrationTeamData?
  players     RegistrationPlayer[]

  @@unique([seasonId, teamId])
  @@index([seasonId, status, updatedAt])
  @@index([teamId])
  @@index([submittedById])
  @@index([reviewedById])
}

model RegistrationTeamData {
  id              String   @id @default(cuid())
  registrationId  String   @unique
  teamName        String
  teamDoctor      String?
  headCoach       String?
  teamLeader      String?
  coachPhone      String?
  leaderPhone     String?
  homeJerseyColor String
  awayJerseyColor String
  teamLogo        String?
  homeJersey      String?
  awayJersey      String?
  gender          String   @default("MALE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  registration TeamRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model RegistrationPlayer {
  id             String   @id @default(cuid())
  registrationId String
  playerId       String?
  name           String
  studentId      String
  jerseyNumber   String
  photo          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registration TeamRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  player       Player?          @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([playerId])
}

// 普通用户独立存储；原 User 表仅保留工作人员及原有后台业务外键。
model MemberAccount {
  id                  String       @id @default(cuid())
  username            String       @unique
  password            String
  nickname            String?
  realName            String?
  requestedStudentId  String?
  studentId           String?      @unique
  verificationStatus  String       @default("PENDING")
  verificationVersion Int          @default(1)
  reviewComment       String?
  reviewedBy          String?
  reviewedAt          DateTime?
  disabled            Boolean      @default(false)
  source              String       @default("web")
  sessionVersion      Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  predictions         Prediction[]

  @@index([verificationStatus, createdAt])
}

// 独立生命周期账本，不随账号级联删除，不纳入普通业务备份。
model CampusCardAsset {
  id            String    @id @default(cuid())
  memberId      String?
  version       Int       @default(1)
  objectKey     String    @unique
  state         String    @default("STAGING")
  // false 表示写入尚未确认结束；即使 HEAD 404 也不得释放容量。
  uploadSettled Boolean   @default(true)
  deleteAfter   DateTime
  nextAttemptAt DateTime  @default(now())
  attempts      Int       @default(0)
  leaseUntil    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([state, nextAttemptAt])
  @@index([memberId, version])
}

// 数据库共享限流，不依赖单实例内存。
model AuthRateLimit {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
