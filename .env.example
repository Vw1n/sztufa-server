# Application
NODE_ENV=development
PORT=3001

# Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sztu_fa?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sztu_fa?schema=public"

# Local authentication
JWT_SECRET="local-development-secret-change-me"
JWT_EXPIRES_IN="7d"

# Cloudflare R2
# 本地不测试上传时可以暂时留空
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Campus cards: dedicated PRIVATE R2 bucket, never the public image bucket.
# Set confirmation to true only after verifying anonymous access is denied.
CARD_R2_ENDPOINT=
CARD_R2_ACCESS_KEY_ID=
CARD_R2_SECRET_ACCESS_KEY=
CARD_R2_BUCKET_NAME=
CARD_STORAGE_PRIVATE_CONFIRMED=false
# 生产必须设置两个不同的安全随机 JWT 密钥，各至少 32 字节；示例值将被拒绝。
MEMBER_JWT_SECRET=
# Required for the optional long-running cleanup worker (see deployment guide).
CARD_CLEANUP_ENDPOINT=

# Backup cron
CRON_SECRET="local-cron-secret"

# Allowed frontend origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3002"

# Production requires explicit trusted proxy IP/CIDR list. Use none for direct connections.
# Never trust all private networks. Configure the actual deployment proxy addresses.
TRUST_PROXY=none

# Backup optimization & security limits
BACKUP_MAX_COMPRESSED_BYTES=104857600
BACKUP_MAX_UNCOMPRESSED_BYTES=209715200
BACKUP_RETENTION_DELETE_ENABLED=false
BACKUP_RESTORE_ENABLED=false
BACKUP_UPLOAD_TOKEN_TTL_SECONDS=3600
BACKUP_PAGE_SIZE=500
BACKUP_MAX_RECORD_BYTES=5242880
BACKUP_RESTORE_TX_TIMEOUT_MS=300000

# History JSON import transaction (capped at 240 seconds in application code)
IMPORT_TRANSACTION_TIMEOUT_MS=240000
